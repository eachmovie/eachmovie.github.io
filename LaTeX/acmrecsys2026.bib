@article{ebert1996critical,
  author = {Ebert, Roger},
  title = {Siskel {\&} {E}bert online: Roger's reviews},
  journal = {Yahoo!\ Internet Life},
  year = {1996},
  month = {September},
  volume = {2},
  number = {4},
  pages = {30--38},
  note = {\url{https://osf.io/x2p6v/files/yqspu}. Ebert wrote that EachMovie \emph{``proposes to suggest movies you might enjoy based on your opinions of movies you have seen [\ldots{}] To my absolute astonishment, the program evaluated my ratings and advised me I would probably enjoy \emph{Pather Panchali}, \emph{Before the Rain}, \emph{Land and Freedom}, \emph{Chungking Express}, and \emph{Red}. This was \emph{uncannily accurate} [\ldots{}] The program was so much on the money, indeed, that I pictured a \emph{Wizard of Oz}-type figure hiding behind the curtains, manually inserting suggestions, so I logged on again using a different address and password, and this time the program's recommendations included the splendid choices \emph{Theremin}, \emph{Fargo}, and \emph{Crumb}. I am forced to concede that Each Movie works \ldots{} for me, anyway''\!.} Ebert also briefly reviewed the $k$-\textsc{nn} movie-recommender system MovieCritic~\cite{Resnick1997} and said its success rate ``was comparable'' to EachMovie's, but see Section~\ref{section:Other_approaches}, above},
}

